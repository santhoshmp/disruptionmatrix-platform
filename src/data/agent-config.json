    {
      "type": "impact-assessment",
      "category": "Impact",
      "mission": "Event-driven agent that receives scored events, pulls published flight schedules for affected airports, and computes per-airport and per-airline operational exposure (the OPS object). Uses public schedule data only \u2014 does not access confidential airline operational data.",
      "triggerModel": "event-driven",
      "triggers": [
        {
          "event": "event.created",
          "condition": "EDPS >= 30",
          "action": "compute OPS for new event"
        },
        {
          "event": "event.updated",
          "condition": "EDPS delta >= 5 or geo/time window changed",
          "action": "recompute OPS"
        },
        {
          "event": "event.escalated",
          "condition": "score band boundary crossed",
          "action": "recompute OPS + flag for airline solver re-intersection"
        },
        {
          "event": "schedule.updated",
          "condition": "published schedule changes for airport with active event",
          "action": "recompute OPS for affected events"
        }
      ],
      "dataSources": [
        {
          "name": "OAG / airline published timetables",
          "tier": 1,
          "scope": "airports",
          "provides": "scheduled flights per airport per day (flight no, origin, dest, dep/arr times, aircraft type, airline)"
        },
        {
          "name": "Flight tracking APIs (FlightAware, Flightradar24)",
          "tier": 1,
          "scope": "airports",
          "provides": "real-time scheduled vs. actual times, cancellations, diversions"
        },
        {
          "name": "Airport slot coordinator data",
          "tier": 1,
          "scope": "hub",
          "provides": "slot allocations per airline per airport"
        },
        {
          "name": "Airline registry (internal config)",
          "tier": 1,
          "scope": "global",
          "provides": "airline metadata: hub, secondary hub, fleet, daily departures, network share per airport, bank structure, fleet capabilities"
        },
        {
          "name": "IATA/ICAO airport directory",
          "tier": 1,
          "scope": "global",
          "provides": "airport coordinates, runway capabilities (CAT IIIB status), capacity"
        },
        {
          "name": "Seasonal schedule (SSIM)",
          "tier": 1,
          "scope": "global",
          "provides": "seasonal schedule variations, bank structure patterns"
        }
      ],
      "exposureModel": {
        "airlineExposureFormula": "airlineExposure = edps * (0.35 * hubFactor + 0.25 * movementShareFactor + 0.20 * fleetCapabilityFactor + 0.10 * bankOverlapFactor + 0.10 * overflightFactor)",
        "factors": [
          {
            "name": "hubFactor",
            "range": "0.5-1.5",
            "description": "1.5 if affected airport is airline primary hub; 1.2 if secondary hub; 0.8 if focus city; 0.5 if outstation"
          },
          {
            "name": "movementShareFactor",
            "range": "0.3-1.2",
            "description": "Normalized airline movement share at affected airport (netShare / 100 * 1.2, capped at 1.2)"
          },
          {
            "name": "fleetCapabilityFactor",
            "range": "0.5-1.3",
            "description": "1.3 if airline fleet lacks capability for hazard (e.g. no CAT IIIB for fog); 1.0 if neutral; 0.5 if specifically equipped"
          },
          {
            "name": "bankOverlapFactor",
            "range": "0.5-1.2",
            "description": "1.2 if event window overlaps airline most sensitive bank; 1.0 if any bank; 0.5 if off-peak"
          },
