  "agentTypes": [
    {
      "type": "weather",
      "category": "Weather",
      "mission": "Detect developing meteorological hazards (storms, fog, monsoon, cyclones, snow, low visibility) that reduce airport capacity or close airspace.",
      "pollIntervalMinutes": 5,
      "dataSources": [
        {
          "name": "NOAA/NWS Aviation Weather Center (METAR/TAF/SIGMET)",
          "tier": 1,
          "scope": "airports",
          "mode": "real",
          "url": "https://aviationweather.gov/api/data"
        },
        {
          "name": "Open-Meteo (ECMWF/GFS forecasts)",
          "tier": 1,
          "scope": "bbox",
          "mode": "real",
          "url": "https://api.open-meteo.com/v1/forecast"
        },
        {
          "name": "NASA EONET (natural events)",
          "tier": 1,
          "scope": "global",
          "mode": "real",
          "url": "https://eonet.gsfc.nasa.gov/api/v3/events"
        },
        {
          "name": "Tropical cyclone advisories (JTWC, RSMC)",
          "tier": 1,
          "scope": "maritime",
          "mode": "planned"
        },
        {
          "name": "Lightning detection networks",
          "tier": 2,
          "scope": "bbox",
          "mode": "planned"
        },
        {
          "name": "Mock weather data (fallback)",
          "tier": 2,
          "scope": "all",
          "mode": "mock",
          "url": "server/connectors/mock-weather.js"
        }
      ],
      "factorMapping": {
        "probability": "Model agreement (ECMWF/GFS spread), number of met services converging",
        "severity": "Gust speeds vs. crosswind limits, visibility vs. CAT minima, rainfall intensity",
        "geographicReach": "Wind field / fog extent radius, airports within bbox",
        "expectedDuration": "Forecast window + recovery time",
        "timeToImpact": "Forecast onset time minus now",
        "escalationRate": "Score delta across last 3 model cycles",
        "sourceCredibility": "Tier rating of met services corroborating",
        "predictionConfidence": "Ensemble spread agreement"
      },
      "hazardTypes": [
        "storm",
        "fog",
        "monsoon",
        "cyclone",
        "snow",
        "low_visibility",
        "wind_shear",
        "thunderstorm"
      ],
      "dataSourceMode": "real"
    },
