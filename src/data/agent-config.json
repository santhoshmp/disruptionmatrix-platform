  "outputContract": {
    "description": "Each agent emits signals matching this schema. The Correlation & Scoring Engine consumes these and produces EVENTS[] entities.",
    "fields": {
      "agentId": "string - agent instance identifier",
      "agentType": "string - one of: weather, atc, industrial, geopolitical, infrastructure, regulatory",
      "region": "string - region ID (R1-R7)",
      "subRegion": "string - sub-region ID",
      "signalId": "string - unique signal identifier",
      "detected": "ISO 8601 timestamp - when the signal was detected",
      "name": "string - human-readable event name",
      "hazardType": "string - specific hazard subtype (see agentTypes[].hazardTypes)",
      "geo": {
        "lat": "number",
        "lon": "number",
        "radiusKm": "number"
      },
      "airports": "string[] - IATA codes of affected airports",
      "airspace": "string[] - FIR/UIR names affected",
      "summary": "string - plain-language summary",
      "factorHints": {
        "probability": "number 0-100",
        "severity": "number 0-100",
        "geographicReach": "number 0-100",
        "expectedDuration": "number 0-100",
        "timeToImpact": "number 0-100",
        "escalationRate": "number 0-100",
        "sourceCredibility": "number 0-100",
        "predictionConfidence": "number 0-100"
      },
      "domains": "string[] - affected operational domains (subset of the 9 domains)",
      "preliminaryEffects": [
        {
          "ord": "number",
          "title": "string",
          "lead": "string"
        }
      ],
      "evidence": [
        {
          "source": "string",
          "tier": "number 1-3",
          "role": "string",
          "timestamp": "ISO 8601",
          "excerpt": "string"
        }
      ],
      "rawRefs": "string[] - references to raw source data for audit"
    }
  },
  "impactOutputContract": {
    "description": "The ImpactAssessmentAgent produces OPS[eventId] objects matching this schema. These attach to EVENTS[] and provide per-airport and per-airline operational exposure.",
    "fields": {
      "agentId": "string - always 'impact-assessment'",
      "eventId": "string - links to EVENTS[].id",
      "computedAt": "ISO 8601 timestamp - when OPS was computed",
      "basis": "string - methodology note",
      "airports": [
        {
          "iata": "string - IATA code",
          "name": "string - airport name",
          "role": "string - 'Affected' or 'Overflight'",
          "movements": "number - scheduled arrivals + departures in time window",
          "window": "string - event time window duration (human-readable)",
          "exposure": "number 0-100 - airport-level exposure score",
          "note": "string - airport-specific impact detail"
        }
      ],
      "airlines": [
        {
          "name": "string - airline name",
          "code": "string - IATA code",
          "hub": "string - airline primary hub IATA code",
          "daily": "number - airline daily departures",
          "netShare": "number - airline movement share at affected airport (%)",
          "airports": "string - affected airports where airline operates (joined with ' . ')",
          "exposure": "string - Critical / High / Moderate / Low",
          "exposureScore": "number 0-100 - computed airline exposure score",
          "note": "string - exposure drivers explanation",
          "drivers": {
            "hubFactor": "number 0.5-1.5",
            "movementShareFactor": "number 0.3-1.2",
            "fleetCapabilityFactor": "number 0.5-1.3",
            "bankOverlapFactor": "number 0.5-1.2",
            "overflightFactor": "number 0.5-1.3"
          }
        }
      ],
      "airlineScores": "object - preliminary per-airline exposure scores keyed by airline key (namma, eva, ica)",
      "overflightExposure": [
        {
          "airline": "string",
          "code": "string",
          "route": "string - affected route (e.g. 'BLR-LHR')",
          "airspace": "string - affected airspace",
          "impact": "string - impact description"
        }
      ]
    }
  },
  "edpsFactors": [
    {
      "label": "Probability of occurrence",
      "weight": 0.18
    },
    {
      "label": "Severity if realised",
      "weight": 0.18
    },
    {
      "label": "Geographic reach",
      "weight": 0.12
    },
    {
      "label": "Expected duration",
      "weight": 0.12
    },
    {
      "label": "Time to impact",
      "weight": 0.14
    },
    {
      "label": "Escalation rate",
      "weight": 0.1
    },
    {
      "label": "Source credibility",
      "weight": 0.1
    },
    {
      "label": "Prediction confidence",
      "weight": 0.06
    }
  ],
  "operationalDomains": [
    "Flight schedule",
    "Crew",
    "Aircraft rotations",
    "Airport operations",
    "Passengers",
    "Cargo",
    "Catering",
    "Maintenance",
    "Regulatory"
  ],
  "scoreBands": [
    {
      "min": 80,
      "max": 100,
      "band": "Critical",
      "color": "#F0495A",
      "escalation": "L4"
    },
    {
      "min": 65,
      "max": 79,
      "band": "High",
      "color": "#F5A623",
      "escalation": "L3"
    },
    {
      "min": 45,
      "max": 64,
      "band": "Moderate",
      "color": "#E8C34A",
      "escalation": "L2"
    },
    {
      "min": 0,
      "max": 44,
      "band": "Low",
      "color": "#5B92C9",
      "escalation": "L1"
    }
  ],
  "sourceTiers": [
    {
      "tier": 1,
      "definition": "Official / authoritative source",
      "examples": "Met service, ATC authority, airport operator, regulator"
    },
    {
      "tier": 2,
      "definition": "Corroborating professional source",
      "examples": "News wire, industry monitoring service"
    },
    {
      "tier": 3,
      "definition": "Supplementary / unverified",
      "examples": "Social media, spotter reports"
    }
  ],
  "pipeline": [
    {
      "step": 1,
      "name": "Collection",
      "description": "Agents poll their data sources at configured intervals"
    },
    {
      "step": 2,
      "name": "Normalization",
      "description": "Geocode, timestamp (UTC), source-tier, category tag"
    },
    {
      "step": 3,
      "name": "Correlation",
      "description": "Dedup (geo+time+category), merge corroborating sources, group signals into candidate events"
    },
    {
      "step": 4,
      "name": "Scoring (EDPS)",
      "description": "EDPS = sum(factor.val * factor.weight) for 8 factors; derive conf, traj, tti, esc"
    },
    {
      "step": 5,
      "name": "Domain Impact",
      "description": "Compute 9-domain vector (0-100 per domain) from agent domain tags + category heuristics"
    },
    {
      "step": 6,
      "name": "Causal Chain",
      "description": "Expand preliminaryEffects into 1st/2nd/3rd order chain with likelihood + lead time"
    },
    {
      "step": 7,
      "name": "Evidence Assembly",
      "description": "Attach evidence[] trail with tier + role; assign ref (DM-YYYY-NNNN)"
    },
    {
      "step": 8,
      "name": "Impact Assessment",
      "description": "ImpactAssessmentAgent pulls published schedules for affected airports, computes per-airport + per-airline exposure (OPS[eventId])"
    },
    {
      "step": 9,
      "name": "Event Store",
      "description": "Publish to EVENTS[] + OPS[] (time-series); trigger airline solver intersection"
    }
  ]
}