# DisruptionMatrix Backend — Environment Variables
# Copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, or local)
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Agents ────────────────────────────────────────────────────────
# Set to 'off' to disable agent polling loops (useful for testing)
AGENTS=on

# ── Server ────────────────────────────────────────────────────────
# Port is auto-assigned by Railway; locally defaults to 3001
# PORT=3001

# ── LLM (optional — configure via Admin Settings UI) ─────────────
# API keys are stored in the database, not here.
# The custom provider uses OpenAI-compatible endpoints:
#   vLLM, TGI, Ollama, LM Studio, LocalAI, etc.
