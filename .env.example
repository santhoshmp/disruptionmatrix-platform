VITE_AUTH_USER=opsadmin
VITE_AUTH_PASS=disrupt2026

# ── Map Engine ──────────────────────────────────────────────────────
# The world/agent/airline maps can render with Leaflet (default, free OSM
# tiles) or a GL vector engine. The GL engine is selected automatically:
#   - VITE_MAPBOX_TOKEN set → mapbox-gl with Mapbox dark style
#   - otherwise            → maplibre-gl with free CARTO dark vector tiles
# Force a specific GL engine: VITE_MAP_ENGINE=mapbox  |  maplibre
# Override the basemap styles: VITE_MAP_STYLE (dark) / VITE_MAP_STYLE_LIGHT (light)
# Mapbox token: create a free account at https://account.mapbox.com/
VITE_MAP_ENGINE=
VITE_MAPBOX_TOKEN=
VITE_MAP_STYLE=
VITE_MAP_STYLE_LIGHT=

# ── Flight Schedule Data Sources ────────────────────────────────────
# OpenSky Network (free, anonymous works but rate-limited; OAuth2 for higher limits)
# Sign up at https://opensky-network.org/ → Account → Create API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AviationStack (free tier: 100 requests/month)
# Sign up at https://aviationstack.com/ → Free Plan
AVIATIONSTACK_KEY=

# AirLabs (free tier: ~1,000 requests/month — preferred over AviationStack)
# Sign up at https://airlabs.co/ → API Key on account dashboard
AIRLABS_KEY=

# ── Social Feed Sources ─────────────────────────────────────────────
# Reddit API (free OAuth tier: 100 queries/minute)
# Register a personal-use script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
